<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width" />"
    <title>@ViewBag.Title</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background-color: #e3e6e6;
            padding: 10px;
        }

        .navbar {
            background-color: #232f3e;
            display: flex;
            align-items: center;
            padding: 8px 15px;
            gap: 15px;
            border-radius: 4px;
        }

        .logo img {
            height: 30px;
            display: block;
            object-fit: contain;
        }

        .search-box {
            display: flex;
            flex: 1;
        }

            .search-box button {
                height: 35px;
                padding: 0 15px;
                background: #f3a847;
                border: none;
                border-radius: 0 4px 4px 0;
                cursor: pointer;
                font-weight: bold;
                color: #111;
            }

        .menu {
            display: flex;
            align-items: center;
            list-style: none;
            gap: 10px;
            white-space: nowrap;
        }

        .main-content {
            padding: 20px 0;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .card {
            background: #ffffff;
            padding: 15px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .card h3 {
                font-size: 16px;
                font-weight: bold;
                color: #0f1111;
                margin-bottom: 10px;
            }

        .card-single-img img {
            width: 100%;
            height: 200px;
            object-fit: contain;
            margin-bottom: 10px;
        }

        .quad-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 10px;
        }

        .quad-item {
            font-size: 11px;
            color: #0f1111;
        }

            .quad-item img {
                width: 100%;
                height: 90px;
                object-fit: cover;
                margin-bottom: 4px;
            }

        .card-link {
            color: #007185;
            text-decoration: none;
            font-size: 12px;
            margin-top: auto;
        }

            .card-link:hover {
                color: #c7511f;
                text-decoration: underline;
            }

        .horizontal-slider-card {
            background: #ffffff;
            padding: 15px;
        }

        .slider-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 12px;
        }

            .slider-header h3 {
                font-size: 16px;
                font-weight: bold;
                color: #0f1111;
            }

        .product-row {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

            .product-row img {
                height: 150px;
                object-fit: contain;
                cursor: pointer;
            }
    </style>
</head>
<body>

    <header class="navbar">
        <a href="#" class="logo">
            <img src="~/Controllers/image/ama.png" alt="Amazon" />
        </a>
        <div class="search-box">
            <input type="text" placeholder="Search..." />
            <button type="submit">Go</button>
        </div>
        <ul class="menu">
            <li><a href="#">Your Account</a></li>
            <li><a href="#">Help</a></li>
            <li><a href="#">Cart</a></li>
        </ul>
    </header>
    <div class="top-banner" style="margin-top: 20px; width: 100%;">
        <a href="#">
            <img src="~/Controllers/image/alexa.png" / alt="Shop Amazon Devices with Alexa" style="width: 100%; display: block;" />
        </a>
    </div>
    <div class="product-grid">
        <div class="card-box">
            <a href="#">
                <img src="~/Controllers/image/pc.jpg" alt="Card 1" />
            </a>
        </div>
        <div class="card-box">
            <a href="#">
                <img src="~/Controllers/image/gia dụng.jpg" alt="Card 2" />
            </a>
        </div>
        <div class="card-box">
            <a href="#">
                <img src="~/Controllers/image/nồi.jpg" alt="Card 3" />
            </a>
        </div>
        <div class="card-box">
            <a href="#">
                <img src="~/Controllers/image/máy nướng bánh.jpg" alt="Card 4" />
            </a>
        </div>

        <div class="slider-box">
            <h3 style="margin-bottom: 10px; font-size: 16px;">Related to items you've viewed</h3>
            <div class="product-row">
                <img src="~/Controllers/image/1.jpg" alt="Shirt 1" />
                <img src="~/Controllers/image/2.jpg" alt="Shirt 2" />
                <img src="~/Controllers/image/3.jpg" alt="Shirt 3" />
                <img src="~/Controllers/image/4.jpg" alt="Shirt 4" />
                <img src="~/Controllers/image/5.jpg" alt="Shirt 5" />
            </div>
            <main class="main-content">
                @RenderBody()
            </main>

</body>
</html>